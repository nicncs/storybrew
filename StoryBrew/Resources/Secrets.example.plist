<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to "Secrets.plist" (same folder) and paste your Anthropic API
  key. Secrets.plist is gitignored so the key never gets committed.

  Without a key the app falls back to a basic offline template engine so it
  still runs for demos.
-->
<plist version="1.0">
<dict>
	<key>ANTHROPIC_API_KEY</key>
	<string></string>
</dict>
</plist>
